# API keys for real-world effectiveness tests
# Copy this file to .env and fill in your keys

# Required for tests/mcp-realworld.js and tests/mcp-realworld-hard.js
ANTHROPIC_API_KEY=

# Required for tests/mcp-realworld-gemini.js
GEMINI_API_KEY=

# Optional: GitHub token for indexing private repos (used with --token-env)
# GITHUB_TOKEN=
